# ─── Required ─────────────────────────────────────────────────────────────────
# Secret key for signing JWTs.  Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional static Modal address(es), comma-separated.
# Leave empty to use automatic launch/discovery mode.
# Example: tcp.abc123.modal.run:12345
MODAL_ADDRESSES=

# Enable backend-managed Modal launch/discovery (no manual .env address updates needed).
MODAL_AUTO_SCALE=true

# Start another container when all existing containers have >= this many active clients.
# With MAX_CLIENTS_PER_CONTAINER=5, use threshold=4 for pre-emptive scale-up.
MODAL_SCALE_UP_THRESHOLD=4

# Safety cap on how many Modal containers the backend may manage.
MODAL_MAX_CONTAINERS=3

# Modal CLI command and run target (relative to MODAL_LAUNCH_WORKDIR).
MODAL_CLI_BIN=modal
MODAL_SERVER_ENTRYPOINT=modal_server/server.py
MODAL_LAUNCH_WORKDIR=../

# Auto-launch behavior tuning
MODAL_LAUNCH_TIMEOUT_MS=180000
MODAL_LAUNCH_COOLDOWN_MS=45000

# Port this backend server listens on (default 3001).
PORT=3001

# ─── Optional ─────────────────────────────────────────────────────────────────
# Allowed CORS origin(s) for the frontend (comma-separated).
# In local dev the default localhost:3000 is fine.
CORS_ORIGINS=http://localhost:3000

# Max concurrent TCP clients per Modal container before routing to the next one.
MAX_CLIENTS_PER_CONTAINER=5

# Initial credits granted to new accounts (in cents, default = 500 = $5.00).
INITIAL_CREDITS_CENTS=500
