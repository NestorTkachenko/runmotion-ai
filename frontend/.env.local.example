# Copy this to .env.local for local development,
# or set these as Environment Variables in your Vercel project settings.

# URL of the ARM101 backend server.
# Production (EC2 + Caddy):  https://api.runmotion.ai
# Local dev:                 http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=https://api.runmotion.ai

# Google OAuth Client ID — same value as GOOGLE_CLIENT_ID on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=386895169996-dik1r8cmiv7gonhhs6s56rsu5lishj3q.apps.googleusercontent.com

# Public app URL used for Stripe Checkout redirects.
NEXT_PUBLIC_APP_URL=https://www.runmotion.ai

# Stripe checkout config.
# Publishable key is optional for hosted checkout, but useful for future client-side billing UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY starts with sk_live_... (or sk_test_... in test mode)
# STRIPE_CREDIT_PACK_USD is the checkout amount for one Add Credits purchase.
STRIPE_SECRET_KEY=
STRIPE_CREDIT_PACK_USD=20
